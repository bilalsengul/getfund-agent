{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "getfund": {
      "type": "streamable-http",
      "url": "https://preprod.getfund.space/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth"
          }
        }
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless"
      ]
    }
  }
}
